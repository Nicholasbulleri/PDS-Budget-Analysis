# Copy to .env and fill in real values. Never commit .env.
# EDP connection uses the same pattern as Databricks OAuth (browser login or service principal).

# ---- Databricks ----
DATABRICKS_SERVER_HOSTNAME=adb-2797612873867894.14.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/7c126f1ffa0e181e
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=default

# Auth: "browser" = Databricks OAuth (opens browser to sign in). "service_principal" = Azure AD client credentials.
DATABRICKS_AUTH_MODE=browser

# Optional: OAuth redirect port and SSL (defaults: 8030, SSL on)
# DATABRICKS_OAUTH_REDIRECT_PORT=8030
# DATABRICKS_OAUTH_BACKGROUND_TAB=true
# DATABRICKS_OAUTH_AUTO_CLOSE_TAB=true

# Disable SSL verification if you see certificate errors (e.g. corporate proxy). Same as EDP_SSL_VERIFY=false.
# DATABRICKS_INSECURE=false

# ---- Service principal (for DATABRICKS_AUTH_MODE=service_principal or automation) ----
# From Azure Portal → App registrations
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# Or use DATABRICKS_CLIENT_ID / DATABRICKS_CLIENT_SECRET

# ---- Legacy / alternative ----
# EDP_SSL_VERIFY=false
# DATABRICKS_USE_AZURE_AD=true
# DATABRICKS_ACCESS_TOKEN=  (personal access token; not recommended)
